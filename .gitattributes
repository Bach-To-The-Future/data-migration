# Corpus files are hashed in corpus/manifest.json, so their line endings must not vary by machine.
corpus/** text eol=lf
sandbox/** text eol=lf
# The engine and docs: LF everywhere, so generated output and diffs do not depend on the checkout.
engine/** text eol=lf
docs/** text eol=lf
# Shell hooks break with CRLF; the repo's tools follow the engine.
.githooks/** text eol=lf
tools/** text eol=lf
