# Copy to sandbox/.env, or let corpus/build.py create it with a generated password.
MSSQL_IMAGE_TAG=2022-CU27-ubuntu-22.04
# Developer for 2022 and earlier images; EnterpriseDeveloper or StandardDeveloper for 2025 images.
MSSQL_PID=Developer
# Fixed at first start. To change it, remove the data volume: python corpus/build.py --reset
MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS
MSSQL_PORT=14333
MSSQL_SA_PASSWORD=change-me
